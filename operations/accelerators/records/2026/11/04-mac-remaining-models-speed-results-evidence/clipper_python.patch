+    model=tmp_path/'sface.onnx';model.write_bytes(b'verified')
+    monkeypatch.setattr(native_face,'prepare_coreml_model',lambda *a,**kw:model)
+    gpu=SimpleNamespace(fail=False,calls=0)
+    def run(*a):
+        from onnxruntime.capi.onnxruntime_pybind11_state import EPFail
