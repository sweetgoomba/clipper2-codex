+++ b/clipper_accelerators/clipper_accelerators/native_sface.py
@@ -0,0 +1,52 @@
+"""Original SFace BGR alignment, with locally checked FP32 CoreML features."""
+import os
+import platform
+from types import SimpleNamespace
+import cv2
+import numpy as np
+from . import runtime
+from .native_face import CoreMLFaceSession,_MODEL_SPECS
+
+
+class _CPU:
+    def __init__(self,native):self.native=native
+    def get_inputs(self):return [SimpleNamespace(name='data',shape=[1,3,112,112])]
+    def get_outputs(self):return [SimpleNamespace(name='fc1')]
+    def get_providers(self):return ['opencv_cpu']
+    def run(self,outputs,inputs):
+        # Caller accepts only aligned uint8 crops. Flips preserve integral RGB
+        # values; retain float precision while reconstructing OpenCV's BGR.
+        image=np.ascontiguousarray(inputs['data'][0].transpose(1,2,0)[:,:,::-1])
+        return [self.native.feature(image)]
+
+
+class SFaceRecognizer:
+    def __init__(self,native,path):
+        self.native=native
+        self.session=CoreMLFaceSession(path,cpu=_CPU(native),model_id='face.sface')
+    def alignCrop(self,*args):return self.native.alignCrop(*args)
+    def feature(self,image):
+        with self.session.lock:
+            if image.shape!=(112,112,3) or image.dtype!=np.uint8:
+                from .errors import BackendFailure
+                if self.session.accelerated:raise BackendFailure('invalid_output','Unsupported SFace crop',gpu=True)
+                self.session.decided=True
+                result=self.native.feature(image)
+                runtime.record_execution('face.sface','opencv_cpu')
+                return result
+            blob=cv2.dnn.blobFromImage(image,1.,(112,112),swapRB=True,crop=False)
+            result=self.session.run(None,{'data':blob})[0]
+            runtime.record_execution('face.sface','/'.join(self.session.get_providers()))
+            return result
+
+
+def native_recognizer(native,path):
+    if (runtime.mode()!='auto' or platform.system()!='Darwin' or platform.machine()!='arm64'
+            or not os.environ.get('CLIPPER_ACCELERATOR_HOST_URL')
+            or os.environ.get('CLIPPER_ACCELERATORS_WHOLE_UNIT_RECOVERY')!='1'):
+        runtime.record_native('face.sface','opencv_cpu');return native
+    import onnxruntime as ort
+    if ('CoreMLExecutionProvider' not in ort.get_available_providers()
+            or runtime.file_sha(path)!=_MODEL_SPECS['face.sface'][0]):
+        runtime.record_native('face.sface','opencv_cpu');return native
+    return SFaceRecognizer(native,path)
