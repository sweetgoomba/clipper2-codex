+        calls.append(1);return Session(np.ones((1,512),np.float32),delay=.002)
+    def candidate(*a):
+        gpu=Session(-np.ones((1,512),np.float32));state['candidate']=weakref.ref(gpu)
+        return gpu,lambda:{'CoreMLExecutionProvider':gpu.calls}
+    model=module.prepare_coreml_model(None);model.write_bytes(b'valid')
