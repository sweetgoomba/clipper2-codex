+def test_pose_phase_destroys_weights_and_clears_mps_before_releasing_budget(monkeypatch):
+    import sys
+    from dance_highlight.services.pose_engine import PoseEngine
+    from clipper_accelerators import native_sessions
+    class Model:pass
+    model=Model();reference=weakref.ref(model);engine=PoseEngine.__new__(PoseEngine)
+    engine.config=SimpleNamespace(yolo_device='mps');engine._model=model;del model
+    events=[]
+    monkeypatch.setenv('CLIPPER_ACCELERATOR_NATIVE_RELEASE','1')
+    monkeypatch.setattr(native_sessions,'operation_reservation',lambda *a:('pose',300))
+    monkeypatch.setitem(sys.modules,'torch',SimpleNamespace(mps=SimpleNamespace(synchronize=lambda:events.append('sync'),empty_cache=lambda:events.append('empty'))))
+    def release(device,model_id):
+        gc.collect();assert reference() is None and events==['sync','empty']
+        events.append('release');return True
+    monkeypatch.setattr(native_sessions,'release_model',release)
+    assert engine.release_mps_model() is True and engine._model is None
+    assert events==['sync','empty','release']
+
