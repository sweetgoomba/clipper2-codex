+        if gpu.fail:raise EPFail('device lost')
+        return [np.full((1,128),1.0001,np.float32)]
+    gpu.run=run;gpu.get_providers=lambda:['CoreMLExecutionProvider','CPUExecutionProvider']
+    monkeypatch.setattr(native_face,'_candidate_session',lambda *a:(gpu,lambda:{'CoreMLExecutionProvider':3}))
+    native=CPU();recognizer=native_sface.SFaceRecognizer(native,model)
+    yield SimpleNamespace(native=native,gpu=gpu,recognizer=recognizer,module=native_sface)
+    runtime._state.clear();runtime._state.update(previous)
+
+
+def test_sface_preserves_alignment_and_records_correct_model_dimension_and_precision(setup):
+    image=np.arange(112*112*3,dtype=np.uint8).reshape(112,112,3)
+    assert setup.recognizer.alignCrop(image,None) is image
