@@ -0,0 +1,158 @@
+"""Accelerate only the explicitly declared source size; retain original ROI work."""
+import hashlib
+import os
+from pathlib import Path
+import platform
+import statistics
+import threading
+import time
+import numpy as np
+import cv2
+from . import runtime
+from .errors import BackendFailure,failure_record
+from .native_face import _coreml_call,_backend_errors
+from .native_sessions import admit
+
+_SOURCE_SHA='8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4'
+
+
+def prepare_model(source,size):
+    from .assets import home
+    from .cache import SelectionCache
+    from .face_adapter import prepare_model as prepare
+    source_bytes=Path(source).read_bytes()
+    if hashlib.sha256(source_bytes).hexdigest()!=_SOURCE_SHA:raise ValueError('unrecognized YuNet source')
+    import onnxruntime as ort
+    import onnx
+    if ort.__version__!='1.31.0' or onnx.__version__!='1.20.1':raise ValueError('unverified YuNet converter')
+    padded=tuple((v+31)//32*32 for v in size)
+    data=prepare(source_bytes,spatial_size=padded)  # Original FP32 weights and padded pixels.
+    key=hashlib.sha256(data).hexdigest();root=home()/'native-coreml'/key;path=root/'yunet.onnx'
+    with SelectionCache(home()/'native-coreml-locks')._lock(key):
+        if not path.is_file() or path.is_symlink() or runtime.file_sha(path)!=key:
+            root.mkdir(parents=True,exist_ok=True)
+            from tempfile import NamedTemporaryFile
+            temporary=None
+            try:
+                with NamedTemporaryFile(dir=root,delete=False) as stream:
+                    temporary=Path(stream.name);stream.write(data);stream.flush();os.fsync(stream.fileno())
+                os.replace(temporary,path)
+            finally:
+                if temporary is not None:temporary.unlink(missing_ok=True)
+    return path
+
+
+def candidate(path,size,score,nms,top_k):
+    from .native_face import _candidate_session
+    from .face_adapter import decode_yunet
+    session,finish=_candidate_session(path)
+    name=session.get_inputs()[0].name;names=[v.name for v in session.get_outputs()]
+    padded=tuple((v+31)//32*32 for v in size)
+    def infer(image):
+        height,width=image.shape[:2]
+        blob=cv2.dnn.blobFromImage(cv2.copyMakeBorder(image,0,padded[1]-height,0,padded[0]-width,cv2.BORDER_CONSTANT))
+        values=session.run(None,{name:blob})
+        return decode_yunet(dict(zip(names,values,strict=True)),padded,score,nms,top_k)
+    return infer,finish
+
+
+def _same(before,after):
+    if before is None:return after is None
+    return (isinstance(after,np.ndarray) and before.shape==after.shape
+            and np.isfinite(after).all() and np.allclose(before,after,rtol=1e-5,atol=.001))
+
+
+class StaticYuNet:
+    execution_tracked=True
+    def __init__(self,native,path,score,nms,top_k):
+        self.native=native;self.path=path;self.options=(score,nms,top_k)
+        self.source_size=None;self.decided=False;self.selected=None;self.amount=0
+        self.lock=threading.RLock()
+    def setInputSize(self,size):
+        with self.lock:self.native.setInputSize(size)
+    def prepare_source(self,size):
+        with self.lock:
+            if self.decided and tuple(size)!=self.source_size:
+                raise BackendFailure('invalid_output','YuNet source shape changed within analysis',gpu=self.selected is not None)
+            self.source_size=tuple(size)
+    def release_accelerator(self):
+        if os.environ.get('CLIPPER_ACCELERATOR_NATIVE_RELEASE')!='1':return False
+        with self.lock:
+            if self.selected is None:return False
+            self.selected=None
+            import gc
+            gc.collect()
+            from .native_sessions import release_model
+            released=release_model('ort_coreml','face.yunet')
+            row=runtime.record_native('face.yunet','mixed',reason='source_phase_completed')
+            row.extra.update(accelerator_released=True,reservation_released=released)
+            return released
+    def _record(self,reason,**extra):
+        row=runtime.record_native('face.yunet','ort_coreml' if self.selected else 'opencv_cpu',reason=reason)
+        row.extra.update(release_qualified=False,**extra)
+        return row
+    def _call(self,operation,*args):
+        return _coreml_call(operation,self.amount,*args,model_id='face.yunet')
+    def _trial(self,image):
+        self.decided=True
+        checks=[image,np.ascontiguousarray(image[:,::-1]),np.ascontiguousarray(image[::-1,:])]
+        references=[];cpu=[];finish=None
+        for value in checks:
+            start=time.perf_counter();references.append(self.native.detect(value)[1]);cpu.append((time.perf_counter()-start)*1000)
+        try:
+            path=prepare_model(self.path,self.source_size)
+            self.amount=max(256*1024*1024,((self.source_size[0]+31)//32*32)*((self.source_size[1]+31)//32*32)*3*4*8+64*1024*1024)
+            admit('ort_coreml',model_id='face.yunet',estimated_bytes=self.amount)
+            start=time.perf_counter();infer,finish=self._call(candidate,path,self.source_size,*self.options);load=(time.perf_counter()-start)*1000
+            values=[];times=[]
+            for value,reference in zip(checks,references,strict=True):
+                start=time.perf_counter();output=self._call(infer,value);times.append((time.perf_counter()-start)*1000)
+                if not _same(reference,output):self._record('coreml_quality_failed');return references[0]
+                values.append(output)
+            nodes=self._call(finish);finish=None
+            if not nodes.get('CoreMLExecutionProvider') or statistics.median(times)>=statistics.median(cpu)*.8:
+                self._record('coreml_no_material_gain');return references[0]
+            self.selected=infer
+            self._record('builtin_static_coreml_local_check',profile_verified=True,execution_evidence='profile_nodes',
+                provider_node_counts=nodes,graph_execution='mixed' if nodes.get('CPUExecutionProvider') else 'accelerator_only',
+                precision='fp32',source_sha256=_SOURCE_SHA,derived_sha256=runtime.file_sha(path),
+                accelerated_input_size=list(self.source_size),cpu_median_ms=statistics.median(cpu),candidate_median_ms=statistics.median(times),setup_ms=load)
+            return values[0]
+        except (ValueError,ImportError,cv2.error,*_backend_errors()) as error:
+            self._record('coreml_trial_failed',**({'trial_failure':failure_record(error)} if isinstance(error,BackendFailure) else {'trial_error':str(error)[:1024]}))
+            return references[0]
+        finally:
+            if finish is not None:
+                try:self._call(finish)
+                except (ValueError,*_backend_errors()):pass
+    def detect(self,image):
+        with self.lock:
+            backend='opencv_cpu';start=time.perf_counter()
+            if tuple(image.shape[1::-1])==self.source_size and runtime._state.get('estimates',{}).get('pose.yolov8s',0)>=128:
+                if not self.decided:result=self._trial(image)
+                elif self.selected is None:result=self.native.detect(image)[1]
+                else:
+                    try:
+                        result=self._call(self.selected,image)
+                        if result is not None and (not isinstance(result,np.ndarray) or result.ndim!=2 or result.shape[1]!=15 or not np.isfinite(result).all()):
+                            raise BackendFailure('invalid_output','Invalid YuNet result',gpu=True)
+                    except BackendFailure as error:error.gpu=True;raise
+                    except (cv2.error,ValueError,*_backend_errors()) as error:
+                        raise BackendFailure('oom' if isinstance(error,MemoryError) else 'backend_unavailable','YuNet CoreML failed: '+str(error)[:1024],gpu=True) from error
+                if self.selected is not None:backend='ort_coreml'
+            else:result=self.native.detect(image)[1]
+            row=runtime.record_execution('face.yunet',backend)
+            counts=row.extra.setdefault('execution_counts',{});counts[backend]=counts.get(backend,0)+1
+            seconds=row.extra.setdefault('execution_seconds',{});seconds[backend]=seconds.get(backend,0.)+time.perf_counter()-start
+            return 1,result
+
+
+def native_detector(native,path,score,nms,top_k):
+    if (runtime.mode()!='auto' or platform.system()!='Darwin' or platform.machine()!='arm64'
+            or not os.environ.get('CLIPPER_ACCELERATOR_HOST_URL')
+            or os.environ.get('CLIPPER_ACCELERATORS_WHOLE_UNIT_RECOVERY')!='1'):
+        return native
+    import onnxruntime as ort
+    if 'CoreMLExecutionProvider' not in ort.get_available_providers():return native
+    if runtime.file_sha(path)!=_SOURCE_SHA:return native
+    return StaticYuNet(native,path,score,nms,top_k)
