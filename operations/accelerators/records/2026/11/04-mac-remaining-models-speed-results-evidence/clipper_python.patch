+def release_model(device,model_id):
+    """Called only after destroying the model and synchronizing its device."""
+    if os.environ.get('CLIPPER_ACCELERATOR_NATIVE_RELEASE')!='1':return False
+    key={'mps':('torch_mps',0),'ort_coreml':('ort_coreml',0)}.get(str(device))
+    adapter=_devices.get(key)
+    identity=(adapter,model_id);amount=_reservations.get(identity,0)
+    if not amount:return True
+    try:_leases[adapter].unreserve_native(amount)
+    except BackendFailure:return False  # Retain a conservative reservation.
+    _reservations.pop(identity,None)
+    return True
diff --git a/clipper_accelerators/clipper_accelerators/native_sface.py b/clipper_accelerators/clipper_accelerators/native_sface.py
