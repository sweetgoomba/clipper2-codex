+++ b/tests/test_tts_active_request_health.py
@@ -0,0 +1,56 @@
+"""No model loading: invoke the real sync route with a stub synthesis function."""
+import threading
+from concurrent.futures import ThreadPoolExecutor
+from fastapi import FastAPI
+from clipper_plugin_sdk.base import PluginRuntime
+from tts_supertonic.app import SupertonicTtsPlugin, TtsRequest
+
+
+def test_health_protects_concurrent_sync_requests_until_each_finishes(monkeypatch):
+    plugin = SupertonicTtsPlugin(engine=object())
+    runtime = PluginRuntime(plugin)
+    monkeypatch.setattr(runtime, '_measure_vram', lambda: None)
+    entered = threading.Barrier(3)
+    release = [threading.Event(), threading.Event()]
+    def synthesize(*args, **kwargs):
+        entered.wait(timeout=5)
+        release[int(kwargs['text'])].wait(timeout=5)
+        if kwargs['text'] == '1':
+            raise ValueError('mock synthesis failure')
+        return {'path': 'fake.wav'}
+    monkeypatch.setattr('tts_supertonic.app.synthesize_to_file', synthesize)
+    app = FastAPI()
+    plugin.register_extra_routes(app)
+    route = next(r.endpoint for r in app.routes if r.path == '/tts')
+    with ThreadPoolExecutor(2) as pool:
+        futures = [pool.submit(route, TtsRequest(text=str(i), voice_style='M1', output_root='/unused', relative_path='fake.wav')) for i in range(2)]
+        try:
+            entered.wait(timeout=5)
+            assert runtime.get_health().active_jobs == 2
+            release[0].set()
+            futures[0].result(timeout=5)
+            assert runtime.get_health().active_jobs == 1
+        finally:
+            for event in release:
+                event.set()
+            for future in futures:
+                try:
+                    future.result(timeout=5)
+                except ValueError:
+                    pass
+    assert runtime.get_health().active_jobs == 0
+
+
+def test_sync_request_refreshes_idle_clock_even_on_failure():
+    import time
+    import pytest
+    plugin = SupertonicTtsPlugin(engine=object())
+    runtime = PluginRuntime(plugin)
+    plugin._runtime = runtime
+    runtime._last_activity = time.monotonic() - 1000
+    before = time.monotonic()
+    with pytest.raises(ValueError):
+        with plugin.active_request():
+            raise ValueError('failed request')
+    assert plugin.active_requests == 0
+    assert runtime._last_activity >= before
diff --git a/tests/test_windows_supervisor.py b/tests/test_windows_supervisor.py
new file mode 100644
index 0000000..8daf484
--- /dev/null
+++ b/tests/test_windows_supervisor.py
@@ -0,0 +1,157 @@
+"""No Windows API or plugin execution: fake owned job only."""
+import threading
+import pytest
+from clipper_plugin_sdk.windows_supervisor import supervise
+
+
+class Job:
+    def __init__(self, *, code=0, empty=True):
+        self.code, self.empty = code, empty
+        self.calls = []
+    def spawn(self, argv): self.calls.append(('spawn', argv))
+    def poll(self): return self.code
+    def terminate_and_wait(self, timeout):
+        self.calls.append(('terminate', timeout))
+        if not self.empty: raise TimeoutError('owned job still active')
+    def close(self): self.calls.append(('close',))
+
+
+def test_natural_exit_still_terminates_descendants_before_ack():
+    job, events = Job(code=3), []
+    assert supervise(job, ['python', '-m', 'fake'], threading.Event(), events.append) == 3
+    assert job.calls == [('spawn', ['python', '-m', 'fake']), ('terminate', 5.0), ('close',)]
+    assert events == ['owned_tree_empty']
+
+
+def test_control_eof_terminates_only_owned_job():
+    stop = threading.Event()
+    job, events = Job(code=None), []
+    original_spawn = job.spawn
+    def spawn(argv):
+        original_spawn(argv)
+        stop.set()
+    job.spawn = spawn
+    assert supervise(job, ['fake'], stop, events.append) == 0
+    assert job.calls[-2:] == [('terminate', 5.0), ('close',)]
+    assert events == ['owned_tree_empty']
+
+
+def test_failed_drain_never_acknowledges_cleanup():
+    job, events = Job(empty=False), []
+    with pytest.raises(TimeoutError): supervise(job, ['fake'], threading.Event(), events.append)
+    assert events == []
+    assert job.calls[-1] == ('close',)
+
+
+def test_failed_spawn_closes_job_without_running_uncontained_fallback():
+    job, events = Job(), []
+    def fail(argv): raise OSError('job assignment failed')
+    job.spawn = fail
+    with pytest.raises(OSError): supervise(job, ['fake'], threading.Event(), events.append)
+    assert job.calls == [('close',)]
+    assert events == []
+
+
+def test_host_already_gone_does_not_launch_plugin():
+    stop = threading.Event()
+    stop.set()
+    job, events = Job(), []
+    assert supervise(job, ['fake'], stop, events.append) == 0
+    assert job.calls == [('close',)]
+    assert events == ['owned_tree_empty']
+
+
+def test_native_x64_structure_layouts_match_windows_abi():
+    import ctypes as c
+    from clipper_plugin_sdk import windows_supervisor as w
+    assert c.sizeof(w.DWORD) == 4
+    assert [c.sizeof(t) for t in (w.BasicLimits, w.ExtendedLimits, w.Accounting,
+                                 w.StartupInfo, w.StartupInfoEx, w.ProcessInfo)] == [64, 144, 48, 104, 112, 24]
+    assert w.Accounting.active.offset == 40
+
+
+class FakeKernel:
+    def __init__(self, fail_attribute=False):
+        self.calls = []
+        self.fail_attribute = fail_attribute
+    def InitializeProcThreadAttributeList(self, ptr, count, flags, size):
+        size._obj.value = 128
+        return bool(ptr)
+    def GetCurrentProcess(self): return -1
+    def DuplicateHandle(self, parent, source, target, output, access, inherit, options):
+        assert inherit and options == 2
+        output._obj.value = 100 + len(self.calls)
+        self.calls.append(('duplicate', output._obj.value))
+        return True
+    def UpdateProcThreadAttribute(self, ptr, flags, attribute, values, size, previous, returned):
+        self.calls.append(('attribute', attribute, list(values)))
+        return not self.fail_attribute
+    def CreateProcessW(self, application, command, pa, ta, inherit, flags, env, cwd, startup, info):
+        import ctypes as c
+        from clipper_plugin_sdk import windows_supervisor as w
+        assert inherit
+        assert flags == 0x00080000 | 0x08000000
+        assert startup._obj.startup.cb == c.sizeof(w.StartupInfoEx)
+        assert startup._obj.startup.stdin == 100
+        assert application == 'C:\\Python Dir\\python.exe'
+        assert command.value.startswith('"C:\\Python Dir\\python.exe" -m fake')
+        self.calls.append(('create',))
+        info._obj.process, info._obj.thread = 200, 201
+        return True
+    def CloseHandle(self, handle): self.calls.append(('close', handle)); return True
+    def DeleteProcThreadAttributeList(self, ptr): self.calls.append(('delete_attributes',))
+
+
+@pytest.mark.parametrize('fail', [False, True])
+def test_native_spawn_requires_atomic_job_assignment_and_restricts_inherited_handles(monkeypatch, fail):
+    import sys
+    from types import SimpleNamespace
+    from clipper_plugin_sdk.windows_supervisor import WindowsJob
+    monkeypatch.setitem(sys.modules, 'msvcrt', SimpleNamespace(get_osfhandle=lambda fd: fd))
+    monkeypatch.setattr(sys, 'stdout', SimpleNamespace(fileno=lambda: 1))
+    monkeypatch.setattr(sys, 'stderr', SimpleNamespace(fileno=lambda: 2))
+    job = WindowsJob.__new__(WindowsJob)
+    job.api, job.job, job.process = FakeKernel(fail), 99, None
+    def check(ok):
+        if not ok: raise OSError('injected attribute failure')
+    job._check = check
+    if fail:
+        with pytest.raises(OSError): job.spawn(['C:\\Python Dir\\python.exe', '-m', 'fake'])
+        assert ('create',) not in job.api.calls
+    else:
+        job.spawn(['C:\\Python Dir\\python.exe', '-m', 'fake'])
+        attributes = [v for v in job.api.calls if v[0] == 'attribute']
+        assert attributes == [('attribute', 0x20002, [100, 101, 102]), ('attribute', 0x2000D, [99])]
+        assert job.process == 200
+        assert job.api.calls.index(attributes[-1]) < job.api.calls.index(('create',))
+        assert ('close', 201) in job.api.calls
+    assert all(('close', handle) in job.api.calls for handle in (100, 101, 102))
+    assert job.api.calls[-1] == ('delete_attributes',)
+
+
+def test_native_drain_queries_owned_handle_until_no_active_descendants(monkeypatch):
+    from clipper_plugin_sdk import windows_supervisor as w
+    job = w.WindowsJob.__new__(w.WindowsJob)
+    calls, counts = [], iter([2, 1, 0])
+    class Kernel:
+        def TerminateJobObject(self, handle, code): calls.append(('terminate', handle)); return True
+        def QueryInformationJobObject(self, handle, kind, data, size, returned):
+            calls.append(('query', handle))
+            data._obj.active = next(counts)
+            return True
+    job.api, job.job = Kernel(), 99
+    monkeypatch.setattr(w.time, 'sleep', lambda duration: None)
+    job.terminate_and_wait(1)
+    assert calls == [('terminate', 99), ('query', 99), ('query', 99), ('query', 99)]
+
+
+def test_native_drain_timeout_never_treats_parent_exit_as_empty(monkeypatch):
+    from clipper_plugin_sdk import windows_supervisor as w
+    job = w.WindowsJob.__new__(w.WindowsJob)
+    class Kernel:
+        def TerminateJobObject(self, handle, code): return True
+        def QueryInformationJobObject(self, handle, kind, data, size, returned):
+            data._obj.active = 1
+            return True
+    job.api, job.job = Kernel(), 99
+    with pytest.raises(TimeoutError): job.terminate_and_wait(0)
