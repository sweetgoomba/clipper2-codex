+// No real child process or socket: simulate the supervisor closing without proof.
+function unconfirmedHost() {
+  const host = managerWith({process:null, port:null, runtimeState:'stopped'}, [], []);
+  host.portAllocator.allocate = async () => 45555;
+  let launches = 0;
+  let created;
+  const create = (config) => {
+    launches++;
+    const proc = fakeProcess();
+    proc.stop = async () => { throw Error('tree termination not confirmed'); };
+    created = {config, proc};
+    return proc;
+  };
+  host.runtimeOptions.createPluginProcess = create;
+  return {host, get created() { return created; }, get launches() { return launches; }};
+}
+
+test('proofless close retains process and port and blocks replacement', async (t) => {
+  const saved = global.fetch; global.fetch = async () => ({ok:true});
+  t.after(() => { global.fetch = saved; });
+  const h = unconfirmedHost();
+  await h.host.ensureStarted(PLUGIN);
+  h.created.proc.running = false;
+  h.created.config.onExit(0, new Error('tree termination not confirmed'));
