+test('exit alone is not a tree completion; fragmented proof plus close is required', async () => {
+  const proc = child(); const tree = new OwnedProcessTree(proc);
+  proc.exitCode = 0; proc.emit('exit', 0, null);
+  await assert.rejects(tree.stop({processName:'tts', terminateTimeoutMs:2}), /not confirmed/);
+  proc.stdout.write(proof.slice(0, 17)); proc.stdout.write(proof.slice(17));
+  proc.emit('close', 0, null);
+  await tree.stop({processName:'tts', terminateTimeoutMs:2});
+});
+test('close without empty-job proof fails closed even for code zero', async () => {
+  const proc = child(); const tree = new OwnedProcessTree(proc);
+  proc.emit('close', 0, null);
+  await assert.rejects(tree.stop({processName:'tts'}), /not confirmed/);
+});
+test('graceful completion avoids forced stop; control EOF otherwise asks owned supervisor', async () => {
+  const proc = child(); const tree = new OwnedProcessTree(proc);
+  proc.stdin.on('finish', () => { proc.stdout.write(proof); proc.emit('close', 0, null); });
+  await tree.stop({processName:'tts', gracefulShutdown:async () => false, terminateTimeoutMs:20});
+  assert.equal(proc.stdin.writableEnded, true);
+  const proc2 = child(); const tree2 = new OwnedProcessTree(proc2);
+  await tree2.stop({processName:'tts', gracefulShutdown:async () => {
+    proc2.stdout.write(proof); proc2.emit('close', 0, null); return true;
+  }});
+  assert.equal(proc2.stdin.writableEnded, false);
+});
+test('unrelated/oversized log fragments cannot count as a completion proof', async () => {
+  const proc = child(); const tree = new OwnedProcessTree(proc);
+  proc.stdout.write('x'.repeat(100000)); proc.stdout.write(proof); proc.emit('close', 0, null);
+  await assert.rejects(tree.stop({processName:'tts'}), /not confirmed/);
+});
