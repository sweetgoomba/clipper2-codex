+  assert.deepEqual(pluginModuleArgs('tts', 'win32'), ['-m', 'clipper_plugin_sdk.windows_supervisor', 'tts']);
+  assert.deepEqual(pluginModuleArgs('tts', 'darwin'), ['-m', 'tts']);
