+for (const confirmed of [false, true]) test(`actual process close propagates ownership confirmation=${confirmed}`, async (t) => {
+  t.mock.method(require('../dist-electron/main/logger'), 'createPluginLogger', () => () => {});
+  t.mock.method(require('../dist-electron/main/logging/child-log'), 'writeChildLog', () => {});
+  const log = require('electron-log/main');
+  for (const method of ['info','warn','error']) t.mock.method(log, method, () => {});
+  t.mock.method(console, 'log', () => {});
