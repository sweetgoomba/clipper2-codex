diff --git a/src/main/plugin/windows-owned-tree.ts b/src/main/plugin/windows-owned-tree.ts
new file mode 100644
index 0000000..ab0a833
--- /dev/null
+++ b/src/main/plugin/windows-owned-tree.ts
@@ -0,0 +1,92 @@
+import type { ChildProcess } from 'node:child_process';
+import type { ChildProcessStopOptions } from './child-process-stop';
+
+export function pluginModuleArgs(name: string, platform: NodeJS.Platform = process.platform): string[] {
+  return platform === 'win32'
+    ? ['-m', 'clipper_plugin_sdk.windows_supervisor', name]
+    : ['-m', name];
+}
+
+/** One launch, one private Job Object. Root exit alone proves nothing about descendants. */
+export class OwnedProcessTree {
+  private closed = false;
+  private empty = false;
+  private pending = '';
+  private droppingLine = false;
+  private readonly completion: Promise<void>;
+
+  constructor(readonly proc: ChildProcess) {
+    this.completion = new Promise((resolve) => {
+      proc.once('close', () => {
+        this.closed = true;
+        proc.stdout?.removeListener('data', onData);
+        resolve();
+      });
+    });
+    const onData = (data: Buffer): void => this.consume(data.toString());
+    proc.stdout?.on('data', onData);
+    // uv can exit before its Python supervisor. EOF asks that supervisor to drain its job.
+    proc.once('exit', () => { if (!this.closed) this.requestStop(); });
+    // A closed control pipe is expected if the supervisor exits first.
+    proc.stdin?.on('error', () => undefined);
+  }
+
+  get isClosed(): boolean { return this.closed; }
+  get terminationConfirmed(): boolean { return this.closed && this.empty; }
+
+  async stop(options: ChildProcessStopOptions): Promise<void> {
+    if (!this.closed && options.gracefulShutdown) {
+      let requested = false;
+      try { requested = await options.gracefulShutdown(); } catch { /* continue via owned control pipe */ }
+      if (requested) await this.wait(options.gracefulTimeoutMs ?? 2_000);
+    }
+    if (!this.closed) {
+      this.requestStop();
+      await this.wait(options.terminateTimeoutMs ?? 6_000);
+    }
+    if (!this.closed || !this.empty) {
+      throw new Error(`${options.processName}: owned Windows process tree termination not confirmed`);
+    }
+  }
+
+  private requestStop(): void {
+    if (this.proc.stdin && !this.proc.stdin.destroyed && !this.proc.stdin.writableEnded) {
+      this.proc.stdin.end();
+    }
+  }
+
+  private async wait(timeoutMs: number): Promise<void> {
+    if (this.closed) return;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    try {
+      await Promise.race([this.completion, new Promise<void>((resolve) => {
+        timer = setTimeout(resolve, timeoutMs);
+      })]);
+    } finally {
+      if (timer) clearTimeout(timer);
+    }
+  }
+
+  private consume(text: string): void {
+    for (const part of text.match(/[^\n]*\n|[^\n]+$/g) ?? []) {
+      const complete = part.endsWith('\n');
+      if (!this.droppingLine) {
+        this.pending += part;
+        if (this.pending.length > 16_384) {
+          this.pending = '';
+          this.droppingLine = true;
+        }
+      }
+      if (!complete) continue;
+      if (!this.droppingLine) {
+        try {
+          const event = JSON.parse(this.pending);
+          if (event.v === 1 && event.src === 'python.windows_supervisor' &&
+              event.ctx?.ownedTree === 'owned_tree_empty') this.empty = true;
+        } catch { /* ordinary plugin stdout */ }
+      }
+      this.pending = '';
+      this.droppingLine = false;
+    }
+  }
+}
