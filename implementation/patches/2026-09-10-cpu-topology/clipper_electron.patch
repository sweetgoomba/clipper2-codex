+
+test('Windows reports 12 physical cores separately from 20 logical threads and caches topology', async () => {
+  const calls = [];
+  const snapshot = monitor([cpuTimes(100, 900), cpuTimes(204, 1796)], 'win32', {
+    output: '{"NumberOfCores":12}', calls,
+  });
+  assert.equal((await snapshot()).cpu.physicalCores, 12);
+  const second = await snapshot();
+  assert.equal(second.cpu.physicalCores, 12);
+  assert.equal(second.cpu.logicalCores, 20);
+  assert.equal(calls.length, 1);
+  assert.equal(calls[0].file, 'powershell.exe');
+  assert.ok(calls[0].options.timeout > 0 && calls[0].options.timeout <= 3000);
+  assert.equal(calls[0].options.windowsHide, true);
+});
+
+test('Windows adds physical cores across processor sockets', async () => {
+  const snapshot = monitor([cpuTimes(100, 900)], 'win32', {
+    output: '[{"NumberOfCores":6},{"NumberOfCores":6}]',
+  });
+  assert.equal((await snapshot()).cpu.physicalCores, 12);
+});
+
