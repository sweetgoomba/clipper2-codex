@@ -72,6 +73,55 @@ let gpuCache: GpuCache | null = null;
 let previousCpuTimes: ReturnType<typeof cpus> | undefined;
 let lastCpuPercent: number | undefined;
 
+let cpuTopologyCache: {
+  key: string;
+  expiresAt: number;
+  value: Promise<number | undefined>;
+} | undefined;
+
+function collectPhysicalCpuCores(logicalCores: number): Promise<number | undefined> {
+  const osPlatform = platform();
+  const key = `${osPlatform}:${logicalCores}`;
+  if (cpuTopologyCache?.key === key && cpuTopologyCache.expiresAt > Date.now()) {
+    return cpuTopologyCache.value;
+  }
+  const value = readPhysicalCpuCores(osPlatform, logicalCores);
+  cpuTopologyCache = { key, value, expiresAt: Date.now() + 60_000 };
+  return value;
+}
+
+async function readPhysicalCpuCores(
+  osPlatform: NodeJS.Platform,
+  logicalCores: number,
+): Promise<number | undefined> {
+  try {
+    let physicalCores: number;
+    if (osPlatform === 'win32') {
+      const { stdout } = await execFileAsync('powershell.exe', [
+        '-NoProfile', '-NonInteractive', '-Command',
+        'Get-CimInstance Win32_Processor | Select-Object NumberOfCores | ConvertTo-Json -Compress',
+      ], { timeout: 2_500, windowsHide: true });
+      const result: unknown = JSON.parse(stdout);
+      const sockets: unknown[] = Array.isArray(result) ? result : [result];
+      if (!sockets.length || !sockets.every((socket) =>
+        isRecord(socket) && Number.isInteger(socket.NumberOfCores) && Number(socket.NumberOfCores) > 0,
+      )) return undefined;
+      physicalCores = sockets.reduce<number>((sum, socket) =>
+        sum + Number((socket as Record<string, unknown>).NumberOfCores), 0);
+    } else if (osPlatform === 'darwin') {
+      const { stdout } = await execFileAsync('sysctl', ['-n', 'hw.physicalcpu'], { timeout: 1_500 });
+      physicalCores = Number(stdout.trim());
+    } else {
+      return undefined;
+    }
+    return Number.isInteger(physicalCores) && physicalCores > 0 && physicalCores <= logicalCores
+      ? physicalCores : undefined;
+  } catch {
+    // Topology is supplemental: do not invent cores or lose live CPU/memory data.
+    return undefined;
+  }
+}
