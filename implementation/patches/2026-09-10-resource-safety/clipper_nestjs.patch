+const test=require('node:test');const assert=require('node:assert/strict');
+function setup(t){
+ const {RuntimePressureWatchdog}=require('../dist/modules/workflows/application/runtime-pressure-watchdog.service');
+ let available=5, calls=0;const config={get:()=>undefined};const resources={getSnapshot:async()=>({memory:{availableBytes:available,totalBytes:100}})};
+ const lifecycle={reclaimIdleMemory:async target=>{assert.equal(target,15);calls++;return []}};
+ const watcher=new RuntimePressureWatchdog(config,resources,lifecycle,{canStartProcesses:()=>true});t.after(()=>watcher.onModuleDestroy());
+ return {watcher,resources,setFree:n=>available=n,calls:()=>calls};
+}
+test('watchdog requires three consecutive low samples and observes cooldown',async t=>{
+ const {watcher,calls}=setup(t);await watcher.check();await watcher.check();assert.equal(calls(),0);await watcher.check();assert.equal(calls(),1);await watcher.check();assert.equal(calls(),1);
+});
+test('recovered or unavailable samples reset the pressure sequence',async t=>{
+ const {watcher,resources,setFree,calls}=setup(t);await watcher.check();setFree(20);await watcher.check();setFree(5);await watcher.check();assert.equal(calls(),0);
+ resources.getSnapshot=async()=>{throw Error('offline')};await watcher.check();assert.equal(calls(),0);
+});
+test('watchdog never overlaps sampling',async t=>{
+ const {watcher,resources}=setup(t);let release,reads=0;resources.getSnapshot=async()=>{reads++;await new Promise(r=>release=r);return {memory:{availableBytes:20,totalBytes:100}}};
+ const first=watcher.check();await watcher.check();assert.equal(reads,1);release();await first;
+});
+test('watchdog timer is independent of any dashboard and stops on destruction',async t=>{
+ t.mock.timers.enable({apis:['setTimeout']});const {watcher,resources}=setup(t);let reads=0;resources.getSnapshot=async()=>{reads++;return {memory:{availableBytes:20,totalBytes:100}}};watcher.onModuleInit();t.mock.timers.tick(10000);await new Promise(r=>setImmediate(r));assert.equal(reads,1);watcher.onModuleDestroy();t.mock.timers.tick(10000);assert.equal(reads,1);
+});
