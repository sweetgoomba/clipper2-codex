+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { PythonRuntimeLifecyclePolicy: Policy } = require('../dist/modules/workflows/application/python-runtime-lifecycle-policy.service');
+const { TtsPluginClient } = require('../dist/modules/tts/infrastructure/tts-plugin.client');
+const { PythonPluginWorkflowExecutor: Executor } = require('../dist/modules/workflows/infrastructure/python-plugin-workflow-executor');
+const defer = () => { let resolve; const promise = new Promise(r => resolve = r); return { promise, resolve }; };
+const manifest = name => ({ name, runtimeKind: 'python_plugin', resourceProfile: { idlePolicy: { safeToEvictWhenIdle: true } } });
+function setup(t) {
+ const stops = [], starts = [];
+ const host = { canStartProcesses: () => true, listManifests: async () => ['tts_supertonic', 'dance_highlight'].map(manifest), getManifest: async n => manifest(n), getStatus: async n => ({ name: n, installState: 'installed', runtimeState: 'running', baseUrl: `http://fake/${n}` }), ensureStarted: async n => { starts.push(n); return `http://fake/${n}`; }, stop: async n => { stops.push(n); } };
+ const policy = new Policy(host); const original = global.fetch;
+ global.fetch = async () => ({ ok: true, json: async () => ({ active_jobs: 0 }) });
+ t.after(() => { policy.onModuleDestroy(); global.fetch = original; });
+ return { host, policy, stops, starts };
+}
+test('pending TTS request remains protected even when health reports zero jobs', async t => {
+ const { host, policy, stops } = setup(t); const entered = defer(), response = defer();
+ global.fetch = async url => String(url).endsWith('/tts') ? (entered.resolve(), response.promise) : ({ ok: true, json: async () => ({ active_jobs: 0 }) });
+ const run = new TtsPluginClient(host, policy).synthesize({ text: 'test' });
+ await entered.promise; stops.length = 0; await policy.prepareForRun('dance_highlight');
+ const observed = [...stops]; response.resolve({ ok: true, json: async () => ({ path: 'fake.wav' }) }); await run;
+ assert.deepEqual(observed, []);
+});
+test('new work invalidates cleanup waiting for a health response', async t => {
+ const { policy, stops } = setup(t); const entered = defer(), response = defer();
+ global.fetch = async () => { entered.resolve(); return { ok: true, json: () => response.promise }; };
+ const cleanup = policy.stopIfIdle('tts_supertonic'); await entered.promise;
+ policy.cancelScheduledStop('tts_supertonic'); response.resolve({ active_jobs: 0 });
+ assert.equal(await cleanup, false); assert.deepEqual(stops, []);
+});
+test('cancelling one job never force-stops the shared runtime', async t => {
+ const { host, policy, stops } = setup(t);
+ await new Executor(host, manifest('tts_supertonic'), policy).cancel('one', { jobId: 'one', baseUrl: 'http://fake/tts_supertonic' });
+ assert.deepEqual(stops, []);
+});
+test('new lease waits for an already committed stop before starting', async t => {
+ const { host, policy, starts } = setup(t); const entered = defer(), stopped = defer();
+ host.stop = async () => { entered.resolve(); await stopped.promise; };
+ const cleanup = policy.stopIfIdle('tts_supertonic'); await entered.promise;
+ const work = policy.beginRun('tts_supertonic'); await Promise.resolve(); assert.deepEqual(starts, []);
+ stopped.resolve(); await cleanup; const lease = await work; assert.deepEqual(starts, ['tts_supertonic']); lease.release();
+});
+test('releasing one lease does not release a different owner', async t => {
+ const { policy, stops } = setup(t);
+ const a = await policy.beginRun('tts_supertonic'), b = await policy.beginRun('tts_supertonic');
+ stops.length = 0; a.release(); a.release(); assert.equal(await policy.stopIfIdle('tts_supertonic'), false); assert.deepEqual(stops, []);
+ b.release(); assert.equal(await policy.stopIfIdle('tts_supertonic'), true);
+});
+test('cancel during submit deletes the job again after it becomes registered', async t => {
+ const {host,policy}=setup(t);const entered=defer(), submitted=defer();let cancelled=false;const requests=[];
+ global.fetch=async(url,init)=>{requests.push(init?.method);if(init?.method==='POST'){entered.resolve();await submitted.promise;}return {ok:true,json:async()=>({})};};
+ const executor=new Executor(host,manifest('tts_supertonic'),policy);
+ const run=executor.run({jobId:'one',params:{},signal:new AbortController().signal,setRuntimeBaseUrl:async()=>{},isCancelled:async()=>cancelled});await entered.promise;
+ cancelled=true;await executor.cancel('one',{jobId:'one',baseUrl:'http://fake/tts_supertonic'});submitted.resolve();await run;
+ assert.deepEqual(requests.filter(Boolean),['POST','DELETE','DELETE']);
+});
+test('an already aborted watcher settles without reporting a spurious job failure', async t => {
+ const {host,policy}=setup(t);const executor=new Executor(host,manifest('tts_supertonic'),policy);const controller=new AbortController();controller.abort();let failures=0;
+ await executor.watchPluginEvents('http://127.0.0.1:1',{jobId:'one',signal:controller.signal,fail:async()=>{failures++}});
+ await new Promise(r=>setImmediate(r));assert.equal(failures,0);
+});
+test('a fired timer cannot stop or rearm after a newer owner arrives', async t => {
+ const {policy,stops}=setup(t);t.mock.timers.enable({apis:['setTimeout']});const entered=defer(),reply=defer();
+ global.fetch=async()=>{entered.resolve();return {ok:true,json:()=>reply.promise}};
+ policy.scheduleIdleStop('tts_supertonic');t.mock.timers.tick(60000);await entered.promise;
+ // Register synchronously while the timer callback is awaiting the health body.
+ const pending=policy.beginRun('tts_supertonic');reply.resolve({active_jobs:0});const lease=await pending;
+ assert.equal(stops.includes('tts_supertonic'),false);assert.equal(policy.getLifecycleStatus(manifest('tts_supertonic')).idleStopDueAt,undefined);lease.release();
+});
+test('unknown runtime health is never an idle cleanup candidate',async t=>{
+ const {policy,stops}=setup(t);global.fetch=async()=>({ok:true,json:async()=>({})});
+ assert.equal(await policy.stopIfIdle('tts_supertonic'),false);assert.deepEqual(stops,[]);
+});
+test('conditional UI cleanup respects a live owner and reports the protected result',async t=>{
+ const {PluginsService}=require('../dist/modules/plugins/application/plugins.service');const {policy,host}=setup(t);const lease=await policy.beginRun('tts_supertonic');
+ const service=new PluginsService({get:async()=>({getManifest:async()=>manifest('tts_supertonic')})},{},{},{},{},{},policy);
+ assert.deepEqual(await service.stopIdle('tts_supertonic'),{stopped:false});lease.release();
+});
+test('terminal publication failure settles the watcher and releases runtime ownership', async t => {
+ const http=require('node:http');const {WebSocketServer}=require('ws');const {host,policy}=setup(t);
+ const server=http.createServer();const wss=new WebSocketServer({server});wss.on('connection',socket=>socket.send(JSON.stringify({type:'completed',status:'completed'})));
+ await new Promise(r=>server.listen(0,'127.0.0.1',r));t.after(()=>{for(const socket of wss.clients)socket.terminate();wss.close();server.close()});
+ const url=`http://127.0.0.1:${server.address().port}`;host.ensureStarted=async()=>url;
+ const executor=new Executor(host,manifest('tts_supertonic'),policy);let failures=0,timer;
+ const work=executor.run({jobId:'one',params:{},signal:new AbortController().signal,setRuntimeBaseUrl:async()=>{},isCancelled:async()=>false,publishEvent:async()=>{throw Error('publication failed')},fail:async()=>{failures++}});
+ try {await Promise.race([work,new Promise((_,reject)=>timer=setTimeout(()=>reject(Error('watcher did not settle')),200))]);}finally{clearTimeout(timer)}
+ assert.equal(failures,1);assert.equal(policy.getLifecycleStatus(manifest('tts_supertonic')).activeOwners,0);
+});
