diff --git a/src/modules/workflows/application/runtime-pressure-watchdog.service.ts b/src/modules/workflows/application/runtime-pressure-watchdog.service.ts
new file mode 100644
index 0000000..cd79245
--- /dev/null
+++ b/src/modules/workflows/application/runtime-pressure-watchdog.service.ts
@@ -0,0 +1,72 @@
+import { Injectable, Logger, OnModuleDestroy, OnModuleInit } from '@nestjs/common';
+import { ConfigService } from '@nestjs/config';
+import { PluginHost } from '../../plugins/domain/plugin-host';
+import { ResourcesService } from '../../resources/application/resources.service';
+import { PythonRuntimeLifecyclePolicy } from './python-runtime-lifecycle-policy.service';
+
+/** Backend-owned RAM observation; never uses CPU load as an eviction signal. */
+@Injectable()
+export class RuntimePressureWatchdog implements OnModuleInit, OnModuleDestroy {
+  private readonly logger = new Logger(RuntimePressureWatchdog.name);
+  private timer?: ReturnType<typeof setTimeout>;
+  private checking = false;
+  private destroyed = false;
+  private lowSamples = 0;
+  private nextCleanupAt = 0;
+
+  constructor(
+    private readonly config: ConfigService,
+    private readonly resources: ResourcesService,
+    private readonly lifecycle: PythonRuntimeLifecyclePolicy,
+    private readonly host: PluginHost,
+  ) {}
+
+  onModuleInit(): void {
+    if (this.config.get<string>('CLIPPER_PLUGIN_PRESSURE_WATCHDOG_ENABLED') === 'false' ||
+        !this.host.canStartProcesses()) return;
+    this.schedule();
+  }
+
+  private schedule(): void {
+    if (this.destroyed) return;
+    this.timer = setTimeout(() => {
+      void this.check().finally(() => this.schedule());
+    }, 10_000);
+    this.timer.unref?.();
+  }
+
+  async check(): Promise<void> {
+    if (this.destroyed || this.checking) return;
+    this.checking = true;
+    try {
+      const snapshot = await this.resources.getSnapshot();
+      if (this.destroyed) return;
+      const { availableBytes, totalBytes } = snapshot.memory;
+      if (!Number.isFinite(totalBytes) || totalBytes <= 0 ||
+          !Number.isFinite(availableBytes) || availableBytes < 0) {
+        this.lowSamples = 0;
+        return;
+      }
+      if (availableBytes / totalBytes >= 0.1) {
+        this.lowSamples = 0;
+        return;
+      }
+      this.lowSamples++;
+      if (this.lowSamples < 3 || Date.now() < this.nextCleanupAt) return;
+      this.lowSamples = 0;
+      this.nextCleanupAt = Date.now() + 60_000;
+      const evicted = await this.lifecycle.reclaimIdleMemory(totalBytes * 0.15);
+      if (evicted.length) this.logger.log(`Memory pressure cleanup: ${evicted.join(', ')}`);
+    } catch (error) {
+      this.lowSamples = 0;
+      this.logger.debug(`Memory pressure sample unavailable: ${error instanceof Error ? error.message : String(error)}`);
+    } finally {
+      this.checking = false;
+    }
+  }
+
+  onModuleDestroy(): void {
+    this.destroyed = true;
+    if (this.timer) clearTimeout(this.timer);
+  }
+}
