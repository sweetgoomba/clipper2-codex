+const {LocalPluginJobRunner}=require('../dist/modules/plugins/application/local-plugin-job.runner');
+const {RuntimePressureWatchdog}=require('../dist/modules/workflows/application/runtime-pressure-watchdog.service');
+const {JobsService}=require('../dist/modules/jobs/application/jobs.service');
+const {DialogHighlightPythonStageRunner}=require('../dist/modules/dialog-highlight/application/dialog-highlight-python-stage.runner');
+test('Nest resolves one lifecycle for direct runner and backend watchdog without starting plugins',async()=>{
+ class SmokeModule {};
+ Module({imports:[ConfigModule.forRoot({isGlobal:true,ignoreEnvFile:true,load:[()=>({CLIPPER_PLUGIN_HOST_MODE:'static',CLIPPER_PLUGIN_PRESSURE_WATCHDOG_ENABLED:'false'})]}),PluginHostModule]})(SmokeModule);
+ const app=await NestFactory.createApplicationContext(SmokeModule,{logger:false});
+ try{const policy=app.get(PythonRuntimeLifecyclePolicy);assert.equal(app.get(LocalPluginJobRunner).lifecycle,policy);assert.equal(app.get(RuntimePressureWatchdog).lifecycle,policy);assert.ok(policy.resources);
+ assert.ok(Reflect.getMetadata('design:paramtypes',JobsService).includes(PythonRuntimeLifecyclePolicy));assert.ok(Reflect.getMetadata('design:paramtypes',DialogHighlightPythonStageRunner).includes(PythonRuntimeLifecyclePolicy));
+ }finally{await app.close()}
+});
