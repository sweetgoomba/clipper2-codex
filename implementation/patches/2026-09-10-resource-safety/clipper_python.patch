diff --git a/tests/test_tts_active_request_health.py b/tests/test_tts_active_request_health.py
new file mode 100644
index 0000000..2173429
--- /dev/null
+++ b/tests/test_tts_active_request_health.py
@@ -0,0 +1,56 @@
+"""No model loading: invoke the real sync route with a stub synthesis function."""
+import threading
+from concurrent.futures import ThreadPoolExecutor
+from fastapi import FastAPI
+from clipper_plugin_sdk.base import PluginRuntime
+from tts_supertonic.app import SupertonicTtsPlugin, TtsRequest
+
+
+def test_health_protects_concurrent_sync_requests_until_each_finishes(monkeypatch):
+    plugin = SupertonicTtsPlugin(engine=object())
+    runtime = PluginRuntime(plugin)
+    monkeypatch.setattr(runtime, '_measure_vram', lambda: None)
+    entered = threading.Barrier(3)
+    release = [threading.Event(), threading.Event()]
+    def synthesize(*args, **kwargs):
+        entered.wait(timeout=5)
+        release[int(kwargs['text'])].wait(timeout=5)
+        if kwargs['text'] == '1':
+            raise ValueError('mock synthesis failure')
+        return {'path': 'fake.wav'}
+    monkeypatch.setattr('tts_supertonic.app.synthesize_to_file', synthesize)
+    app = FastAPI()
+    plugin.register_extra_routes(app)
+    route = next(r.endpoint for r in app.routes if r.path == '/tts')
+    with ThreadPoolExecutor(2) as pool:
+        futures = [pool.submit(route, TtsRequest(text=str(i), voice_style='M1', output_root='/unused', relative_path='fake.wav')) for i in range(2)]
+        try:
+            entered.wait(timeout=5)
+            assert runtime.get_health().active_jobs == 2
+            release[0].set()
+            futures[0].result(timeout=5)
+            assert runtime.get_health().active_jobs == 1
+        finally:
+            for event in release:
+                event.set()
+            for future in futures:
+                try:
+                    future.result(timeout=5)
+                except ValueError:
+                    pass
+    assert runtime.get_health().active_jobs == 0
+
+
+def test_sync_request_refreshes_idle_clock_even_on_failure():
+    import time
+    import pytest
+    plugin = SupertonicTtsPlugin(engine=object())
+    runtime = PluginRuntime(plugin)
+    plugin._runtime = runtime
+    runtime._last_activity = time.monotonic() - 1000
+    before = time.monotonic()
+    with pytest.raises(ValueError):
+        with plugin.active_request():
+            raise ValueError('failed request')
+    assert plugin.active_requests == 0
+    assert runtime._last_activity >= before
