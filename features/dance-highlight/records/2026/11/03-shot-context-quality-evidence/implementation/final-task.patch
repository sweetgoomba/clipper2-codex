+def prove_role_state(
+    records,
+    roles,
+    owned_names,
+    *,
+    video_size,
+    fps,
+    cut_frames,
+    handoffs,
+    camera_episodes,
+    identity_boundaries=(),
+):
+    # Caller supplies only original final_name == direct_joint_name with owned=True.
+    # A joint prediction alone is not a trusted named role and cannot enter here.
