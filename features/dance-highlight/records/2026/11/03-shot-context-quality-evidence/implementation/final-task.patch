+        v = (
+            (p[:, 2] >= 0.5)
+            & (p[:, 0] >= max(0, b[0]))
+            & (p[:, 0] < min(width, b[2]))
+            & (p[:, 1] >= max(0, b[1]))
+            & (p[:, 1] < min(height, b[3]))
+        )
+        xy = p[[5, 6, 11, 12], :2]
+        full = bool(
+            v[:5].sum() >= 2
+            and v[[5, 6, 11, 12, 15, 16]].all()
+            and p[:5, 1][v[:5]].max()
+            < p[[5, 6], 1].mean()
+            < p[[11, 12], 1].mean()
+            < p[[15, 16], 1].mean()
