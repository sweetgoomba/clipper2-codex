+from dataclasses import replace
+import numpy as np
+from clipper_face_core.contracts import EmbeddingSpace, SourceEvidence, ReferenceSample, QueryEvidence
+
+SPACE=EmbeddingSpace('a'*64,'align','bgr','l2_eps1e-9',2,'test')
