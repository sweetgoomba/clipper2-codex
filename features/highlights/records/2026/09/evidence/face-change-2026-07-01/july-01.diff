diff --git a/tests/test_dance_cluster_member_mapping.py b/tests/test_dance_cluster_member_mapping.py
new file mode 100644
index 0000000..e448722
--- /dev/null
+++ b/tests/test_dance_cluster_member_mapping.py
@@ -0,0 +1,30 @@
+from __future__ import annotations
+
+import math
+
+import numpy as np
+
+from dance_highlight.services.pipeline import DancePipeline
+
+
+def _unit(dot_a: float, dot_b: float) -> np.ndarray:
+    rest = math.sqrt(max(0.0, 1.0 - dot_a * dot_a - dot_b * dot_b))
+    return np.array([dot_a, dot_b, rest], dtype=np.float32)
+
+
+def test_cluster_mapping_assigns_distinct_members_before_duplicate_matches() -> None:
+    pipeline = DancePipeline.__new__(DancePipeline)
+
+    mapping = pipeline._map_cluster_to_member_name(
+        cluster_centroids={
+            1: _unit(0.70, 0.52),
+            2: _unit(0.68, 0.51),
+        },
+        ref_embs={
+            "A": np.array([1.0, 0.0, 0.0], dtype=np.float32),
+            "B": np.array([0.0, 1.0, 0.0], dtype=np.float32),
+        },
+        threshold=0.60,
+    )
+
+    assert mapping == {1: "A", 2: "B"}
diff --git a/tests/test_dance_face_cluster_opencv.py b/tests/test_dance_face_cluster_opencv.py
new file mode 100644
index 0000000..5db4a89
--- /dev/null
+++ b/tests/test_dance_face_cluster_opencv.py
@@ -0,0 +1,174 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+
+from dance_highlight.services.face_cluster import FaceClusterService
+from dance_highlight.services.segment import Segment
+
+
+@dataclass
+class DummyConfig:
+    face_det_size: tuple[int, int] = (320, 320)
+    face_min_det_score: float = 0.28
+    face_nms_threshold: float = 0.3
+    face_top_k: int = 5000
+    face_roi_expand_w: float = 0.0
+    face_roi_expand_h_top: float = 0.0
+    face_roi_expand_h_bottom: float = 0.0
+    face_sample_frames: int = 5
+    face_candidate_sample_frames: int = 12
+
+
+class FakeDetector:
+    def __init__(self, faces: np.ndarray | None) -> None:
+        self.faces = faces
+        self.input_size: tuple[int, int] | None = None
+
+    def setInputSize(self, size: tuple[int, int]) -> None:
+        self.input_size = size
+
+    def detect(self, _img: np.ndarray):
+        return 1, self.faces
+
+
+class FakeRecognizer:
+    def __init__(self, feature: np.ndarray) -> None:
+        self.feature_value = feature
+        self.aligned_shape: tuple[int, ...] | None = None
+
+    def alignCrop(self, img: np.ndarray, _face: np.ndarray) -> np.ndarray:
+        self.aligned_shape = img.shape
+        return img
+
+    def feature(self, _aligned: np.ndarray) -> np.ndarray:
+        return self.feature_value
+
+
+class FrameScoreDetector:
+    def setInputSize(self, _size: tuple[int, int]) -> None:
+        pass
+
+    def detect(self, img: np.ndarray):
+        frame_id = int(img[0, 0, 0])
+        score = 0.10 + frame_id * 0.07
+        face = np.array([[0, 0, 10, 10, 1, 1, 8, 1, 5, 5, 2, 8, 8, 8, score]], dtype=np.float32)
+        return 1, face
+
+
+class FrameFeatureRecognizer:
+    def alignCrop(self, img: np.ndarray, _face: np.ndarray) -> np.ndarray:
+        return img
+
+    def feature(self, aligned: np.ndarray) -> np.ndarray:
+        frame_id = float(aligned[0, 0, 0])
+        return np.array([[1.0, frame_id]], dtype=np.float32)
+
+
+class FakeVideoCapture:
+    def __init__(self, total_frames: int = 12, fps: float = 1.0) -> None:
+        self.total_frames = total_frames
+        self.fps = fps
+        self.index = 0
+
+    def isOpened(self) -> bool:
+        return True
+
+    def get(self, prop: int) -> float:
+        if prop == 5:  # cv2.CAP_PROP_FPS
+            return self.fps
+        return 0.0
+
+    def read(self):
+        if self.index >= self.total_frames:
+            return False, None
+        frame = np.full((24, 24, 3), self.index, dtype=np.uint8)
+        self.index += 1
+        return True, frame
+
+    def grab(self) -> bool:
+        if self.index >= self.total_frames:
+            return False
+        self.index += 1
+        return True
+
+    def release(self) -> None:
+        pass
+
+
+def make_service(detector: FakeDetector, recognizer: FakeRecognizer) -> FaceClusterService:
+    service = FaceClusterService.__new__(FaceClusterService)
+    service.config = DummyConfig()
+    service._detector = detector
+    service._recognizer = recognizer
+    return service
+
+
+def test_get_face_embedding_uses_opencv_detector_and_normalizes_feature() -> None:
+    # OpenCV YuNet face row: x, y, w, h, five landmarks, score.
+    faces = np.array([[0, 0, 10, 10, 1, 1, 8, 1, 5, 5, 2, 8, 8, 8, 0.95]], dtype=np.float32)
+    detector = FakeDetector(faces)
+    recognizer = FakeRecognizer(np.array([[3.0, 4.0]], dtype=np.float32))
+    service = make_service(detector, recognizer)
+
+    emb = service.get_face_embedding(np.zeros((24, 32, 3), dtype=np.uint8))
+
+    assert detector.input_size == (32, 24)
+    assert recognizer.aligned_shape == (24, 32, 3)
+    assert emb is not None
+    np.testing.assert_allclose(emb, np.array([0.6, 0.8], dtype=np.float32), rtol=1e-6)
+
+
+def test_get_face_embedding_rejects_below_threshold_face() -> None:
+    faces = np.array([[0, 0, 10, 10, 1, 1, 8, 1, 5, 5, 2, 8, 8, 8, 0.10]], dtype=np.float32)
+    service = make_service(
+        FakeDetector(faces),
+        FakeRecognizer(np.array([[3.0, 4.0]], dtype=np.float32)),
+    )
+
+    assert service.get_face_embedding(np.zeros((24, 32, 3), dtype=np.uint8)) is None
+
+
+def test_get_face_embedding_returns_none_when_no_face_detected() -> None:
+    service = make_service(
+        FakeDetector(None),
+        FakeRecognizer(np.array([[3.0, 4.0]], dtype=np.float32)),
+    )
+
+    assert service.get_face_embedding(np.zeros((24, 32, 3), dtype=np.uint8)) is None
+
+
+def test_batch_segment_embeddings_scans_candidate_frames_and_averages_top_quality(monkeypatch) -> None:
+    service = FaceClusterService.__new__(FaceClusterService)
+    service.config = DummyConfig(face_min_det_score=0.0)
+    service._detector = FrameScoreDetector()
+    service._recognizer = FrameFeatureRecognizer()
+    monkeypatch.setattr(
+        "dance_highlight.services.face_cluster.cv2.VideoCapture",
+        lambda _path: FakeVideoCapture(),
+    )
+
+    segment = Segment(
+        seg_type="main",
+        label=7,
+        start=0.0,
+        end=11.0,
+        bboxes=[
+            (float(i), np.array([0, 0, 20, 20], dtype=np.float32), 7)
+            for i in range(12)
+        ],
+    )
+
+    results = service.batch_segment_embeddings("fake.mp4", [segment])
+
+    top_frame_embeddings = []
+    for frame_id in range(7, 12):
+        emb = np.array([1.0, float(frame_id)], dtype=np.float32)
+        top_frame_embeddings.append(emb / (np.linalg.norm(emb) + 1e-9))
+    expected = np.mean(np.stack(top_frame_embeddings), axis=0)
+    expected = expected / (np.linalg.norm(expected) + 1e-9)
+
+    assert results[0].face_detected is True
+    assert len(results[0].track_embeddings) == 1
+    np.testing.assert_allclose(results[0].track_embeddings[0], expected, rtol=1e-6)
diff --git a/tests/test_dance_face_models.py b/tests/test_dance_face_models.py
new file mode 100644
index 0000000..50e1f84
--- /dev/null
+++ b/tests/test_dance_face_models.py
@@ -0,0 +1,88 @@
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+
+from dance_highlight.services.face_models import (
+    FACE_MODEL_SPECS,
+    FaceModelSpec,
+    ensure_face_models,
+    get_face_model_dir,
+    is_model_file_valid,
+)
+
+
+def test_face_model_specs_are_pinned_to_opencv_models() -> None:
+    specs = {spec.name: spec for spec in FACE_MODEL_SPECS}
+
+    assert specs["opencv-yunet-face-detection"].filename == "face_detection_yunet_2023mar.onnx"
+    assert (
+        specs["opencv-yunet-face-detection"].sha256
+        == "8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4"
+    )
+    assert specs["opencv-yunet-face-detection"].size == 232589
+
+    assert specs["opencv-sface-face-recognition"].filename == "face_recognition_sface_2021dec.onnx"
+    assert (
+        specs["opencv-sface-face-recognition"].sha256
+        == "0ba9fbfa01b5270c96627c4ef784da859931e02f04419c829e83484087c34e79"
+    )
+    assert specs["opencv-sface-face-recognition"].size == 38696353
+
+
+def test_get_face_model_dir_uses_env_override(monkeypatch, tmp_path: Path) -> None:
+    target = tmp_path / "models"
+    monkeypatch.setenv("CLIPPER_DANCE_FACE_MODEL_DIR", str(target))
+
+    assert get_face_model_dir() == target
+
+
+def test_get_face_model_dir_defaults_to_cwd_plugin_models(monkeypatch, tmp_path: Path) -> None:
+    monkeypatch.delenv("CLIPPER_DANCE_FACE_MODEL_DIR", raising=False)
+    monkeypatch.chdir(tmp_path)
+
+    assert get_face_model_dir() == tmp_path / "plugin_models" / "dance_highlight"
+
+
+def test_is_model_file_valid_checks_size_and_sha256(tmp_path: Path) -> None:
+    body = b"model-bytes"
+    path = tmp_path / "model.onnx"
+    path.write_bytes(body)
+    spec = FaceModelSpec(
+        name="fake",
+        filename="model.onnx",
+        url="https://example.invalid/model.onnx",
+        sha256=hashlib.sha256(body).hexdigest(),
+        size=len(body),
+    )
+
+    assert is_model_file_valid(path, spec)
+    assert not is_model_file_valid(path, FaceModelSpec(**{**spec.__dict__, "size": len(body) + 1}))
+    assert not is_model_file_valid(path, FaceModelSpec(**{**spec.__dict__, "sha256": "0" * 64}))
+
+
+def test_ensure_face_models_downloads_missing_files_and_emits_progress(tmp_path: Path) -> None:
+    body = b"downloaded-model"
+    spec = FaceModelSpec(
+        name="fake-opencv-model",
+        filename="model.onnx",
+        url="https://example.invalid/model.onnx",
+        sha256=hashlib.sha256(body).hexdigest(),
+        size=len(body),
+    )
+    events: list[tuple[str, float]] = []
+
+    def fake_downloader(url: str, target: Path, progress_cb) -> None:
+        assert url == spec.url
+        target.write_bytes(body)
+        progress_cb(1.0)
+
+    paths = ensure_face_models(
+        model_dir=tmp_path,
+        specs=[spec],
+        downloader=fake_downloader,
+        progress_cb=lambda name, pct: events.append((name, pct)),
+    )
+
+    assert paths == {"fake-opencv-model": tmp_path / "model.onnx"}
+    assert events == [("fake-opencv-model", 1.0)]
