diff --git a/tests/test_dance_cluster_member_mapping.py b/tests/test_dance_cluster_member_mapping.py
index e448722..eca6279 100644
--- a/tests/test_dance_cluster_member_mapping.py
+++ b/tests/test_dance_cluster_member_mapping.py
@@ -28,3 +28,52 @@ def test_cluster_mapping_assigns_distinct_members_before_duplicate_matches() ->
     )
 
     assert mapping == {1: "A", 2: "B"}
+
+
+def test_single_reference_does_not_absorb_every_cluster() -> None:
+    """참조 멤버가 1명일 때, 임계값 안이라는 이유만으로 모든 클러스터가 흡수되면 안 된다."""
+    pipeline = DancePipeline.__new__(DancePipeline)
+
+    mapping = pipeline._map_cluster_to_member_name(
+        cluster_centroids={
+            1: _unit(0.85, 0.0),   # dist 0.15 — 본인
+            2: _unit(0.50, 0.0),   # dist 0.50 — 남 (0.60 이내지만 본인과 한참 멀다)
+            3: _unit(0.42, 0.0),   # dist 0.58 — 남
+        },
+        ref_embs={"A": np.array([1.0, 0.0, 0.0], dtype=np.float32)},
+        threshold=0.60,
+    )
+
+    assert mapping == {1: "A"}
+
+
+def test_split_clusters_of_same_person_still_merge() -> None:
+    """같은 사람이 두 클러스터로 쪼개진 경우는 계속 한 멤버로 묶여야 한다."""
+    pipeline = DancePipeline.__new__(DancePipeline)
+
+    mapping = pipeline._map_cluster_to_member_name(
+        cluster_centroids={
+            1: _unit(0.85, 0.0),   # dist 0.15
+            2: _unit(0.80, 0.0),   # dist 0.20 — 주인(0.15) + 마진(0.08) 이내
+        },
+        ref_embs={"A": np.array([1.0, 0.0, 0.0], dtype=np.float32)},
+        threshold=0.60,
+    )
+
+    assert mapping == {1: "A", 2: "A"}
+
+
+def test_duplicate_absolute_ceiling_wins_over_margin() -> None:
+    """주인이 멀면 마진만으로 붙지 않는다 — 절대 상한(0.45)이 먼저 막는다."""
+    pipeline = DancePipeline.__new__(DancePipeline)
+
+    mapping = pipeline._map_cluster_to_member_name(
+        cluster_centroids={
+            1: _unit(0.60, 0.0),   # dist 0.40 — 주인
+            2: _unit(0.53, 0.0),   # dist 0.47 — 마진(0.48)엔 들지만 상한 0.45 초과
+        },
+        ref_embs={"A": np.array([1.0, 0.0, 0.0], dtype=np.float32)},
+        threshold=0.60,
+    )
+
+    assert mapping == {1: "A"}
